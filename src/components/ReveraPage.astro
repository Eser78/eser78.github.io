  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 1 0 12 0"/><path d="M4 4l3 3"/><path d="M20 4l-3 3"/><path d="M12 14v3"/><path d="M9 21h6"/></svg>',
  '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/><path d="M4 4l2 2"/><path d="M20 20l-2-2"/></svg>',
];
---

<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  lang={locale}
  canonicalPath={localeConfig[locale].reveraPath}
  alternates={getReveraAlternates()}
  detectBrowserLocale={locale === 'en'}
>
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="stars"></div>
    <nav class="nav">
      <div class="nav-inner">
        <a href={t.homePath} class="nav-brand">
          <img src={`${assetBase}/AppIcon1024.png`} alt="Revera" class="nav-icon" />
          <span>Revera</span>
        </a>
        <div class="nav-links">
          <a href="#features">{t.nav.features}</a>
          <a href="#gallery">{t.nav.gallery}</a>
          <a href="#download" class="nav-cta">{t.nav.download}</a>
        </div>
        <div class="language-switcher" aria-label={t.languageLabel}>
          {
            supportedLocales.map((code) => (
              <a
                href={localeConfig[code].reveraPath}
                class={`language-option${locale === code ? ' active' : ''}`}
                aria-current={locale === code ? 'page' : undefined}
                data-preferred-locale={code}
              >
                {localeConfig[code].label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <div class="hero-content">
      <div class="hero-text">
        <h1>{t.hero.titleLine}<br /><span class="gradient-text">{t.hero.titleAccent}</span></h1>
        <p class="hero-subtitle">{t.hero.subtitle}</p>
        <div class="hero-actions">
          <a href={appStoreUrl} class="store-btn" aria-label={t.store.appStoreAria}>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
            <div>
              <span class="store-label">{t.store.appStoreLabel}</span>
              <span class="store-name">App Store</span>
            </div>
          </a>
          <a href="#" class="store-btn" aria-label={t.store.googlePlayAria}>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85c-.5-.24-.84-.76-.84-1.35m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.56.69.56 1.19s-.22.92-.56 1.19l-1.97 1.13-2.5-2.5 2.5-2.5 1.97 1.13zM6.05 2.66l10.76 6.22-2.27 2.27L6.05 2.66z"/></svg>
            <div>
              <span class="store-label">{t.store.googlePlayLabel}</span>
              <span class="store-name">Google Play</span>
            </div>
          </a>
        </div>
        <div class="hero-badges">
          {t.hero.badges.map((badge) => <span class="badge">{badge}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="features">
    <div class="container">
      <h2 class="section-title">{t.features.titleStart} <span class="gradient-text">{t.features.titleAccent}</span></h2>
      <div class="feature-grid">
        {
          t.features.items.map((item, index) => (
            <div class="feature-card">
              <div class="feature-icon" set:html={featureIcons[index]}></div>
              <span class={`feature-badge ${
                item.badge === t.features.premiumLabel
                  ? 'premium'
                  : item.badge === t.features.mixedLabel
                    ? 'mixed'
                    : 'free'
              }`}>
                {item.badge}
              </span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="gallery" class="screenshots">
    <div class="container">
      <h2 class="section-title">{t.gallery.titleStart} <span class="gradient-text">{t.gallery.titleAccent}</span></h2>
      <div class="screenshot-scroll" tabindex="0" aria-label={`${t.gallery.titleStart} ${t.gallery.titleAccent}`}>
        <div class="screenshot-track">
          {
            screenshots.map((screen, index) => (
              <div class="screenshot-item">
                <img src={`${assetBase}/V2_preview${screen}.png`} alt={t.gallery.imageAlts[index]} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="pricing">
    <div class="container">
      <h2 class="section-title">{t.pricing.titleStart} <span class="gradient-text">{t.pricing.titleAccent}</span></h2>
      <p class="section-subtitle">{t.pricing.subtitle}</p>
      <div class="pricing-grid">
        <div class="pricing-card">
          <h3>{t.pricing.free}</h3>
          <div class="price">{t.pricing.freePrice}</div>
          <ul>
            {t.pricing.freeItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="pricing-card popular">
          <div class="popular-badge">{t.pricing.popular}</div>
          <h3>{t.pricing.premium}</h3>
          <div class="price">{t.pricing.premiumPrice}</div>
          <ul>
            {t.pricing.premiumItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="download" class="download">
    <div class="container">
      <img src={`${assetBase}/AppIcon1024.png`} alt="Revera" class="download-icon" />
      <h2>{t.download.heading}</h2>
      <p>{t.download.text}</p>
      <div class="store-buttons">
        <a href={appStoreUrl} class="store-btn" aria-label={t.store.appStoreAria}>
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          <div>
            <span class="store-label">{t.store.appStoreLabel}</span>
            <span class="store-name">App Store</span>
          </div>
        </a>
        <a href="#" class="store-btn" aria-label={t.store.googlePlayAria}>
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85c-.5-.24-.84-.76-.84-1.35m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.56.69.56 1.19s-.22.92-.56 1.19l-1.97 1.13-2.5-2.5 2.5-2.5 1.97 1.13zM6.05 2.66l10.76 6.22-2.27 2.27L6.05 2.66z"/></svg>
          <div>
            <span class="store-label">{t.store.googlePlayLabel}</span>
            <span class="store-name">Google Play</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <img src={`${assetBase}/AppIcon1024.png`} alt="Revera" class="footer-icon" />
          <p>Revera</p>
          <span class="footer-company">by ESOciate</span>
        </div>
        <div class="footer-section">
          <h4>{localeLabels.legal}</h4>
          <a href={getLegalPath(locale, 'privacyPolicy')}>{localeLabels.privacyPolicy}</a>
          <a href={getLegalPath(locale, 'termsOfUse')}>{localeLabels.termsOfUse}</a>
          <a href={getLegalPath(locale, 'legalNotice')}>{localeLabels.legalNotice}</a>
        </div>
        <div class="footer-section">
          <h4>{localeLabels.contact}</h4>
          <a href="mailto:support@esociate.it.com">support@esociate.it.com</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} ESOciate - Eser Kayali. {t.footer.rights}</p>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 0;
    background: rgba(13, 10, 26, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(124, 58, 237, 0.15);
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--white);
    font-weight: 700;
    font-size: 1.1rem;
    flex: 0 0 auto;
  }

  .nav-icon {
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-left: auto;
    flex: 0 1 auto;
  }

  .nav-links a {
    color: var(--gray-light);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .nav-links a:hover {
    color: var(--white);
  }

  .nav-cta {
    background: var(--purple-bright);
    color: var(--white) !important;
    padding: 0.5rem 1.25rem;
    border-radius: 0.5rem;
    font-weight: 600 !important;
  }

  .nav-cta:hover {
    background: #6d28d9;
  }

  .language-switcher {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.2rem;
    border: 1px solid rgba(124, 58, 237, 0.25);
    border-radius: 0.65rem;
    background: rgba(124, 58, 237, 0.08);
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .language-switcher::-webkit-scrollbar {
    display: none;
  }

  .language-option {
    flex: 0 0 auto;
    min-width: 2.25rem;
    padding: 0.3rem 0.55rem;
    border-radius: 0.45rem;
    color: var(--gray-light);
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
  }

  .language-option:hover,
  .language-option.active {
    background: var(--purple-bright);
    color: var(--white);
  }

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-top: 5rem;
  }

  .features,
  .screenshots,
  .pricing,
  .download {
    scroll-margin-top: 6rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 70% 20%, rgba(124, 58, 237, 0.3) 0%, transparent 60%),
      radial-gradient(ellipse at 30% 80%, rgba(124, 58, 237, 0.15) 0%, transparent 50%);
    z-index: 0;
  }

  .stars {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(2px 2px at 20px 30px, rgba(255, 255, 255, 0.3), transparent),
      radial-gradient(2px 2px at 40px 70px, rgba(255, 255, 255, 0.2), transparent),
      radial-gradient(1px 1px at 90px 40px, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(1px 1px at 130px 80px, rgba(255, 255, 255, 0.2), transparent),
      radial-gradient(2px 2px at 160px 30px, rgba(255, 255, 255, 0.3), transparent);
    background-size: 200px 100px;
    z-index: 0;
    animation: twinkle 4s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    0% { opacity: 0.5; }
    100% { opacity: 1; }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 4rem;
    flex: 1;
  }

  .hero-text {
    flex: 1;
    min-width: 0;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--purple-light), var(--purple-glow), #e879f9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--gray-light);
    max-width: 500px;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .hero-badges {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .badge {
    background: rgba(124, 58, 237, 0.15);
    border: 1px solid rgba(124, 58, 237, 0.3);
    color: var(--purple-light);
    padding: 0.35rem 0.85rem;
    border-radius: 2rem;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .features {
    padding: 6rem 0;
    background: linear-gradient(180deg, var(--purple-deep) 0%, var(--purple-dark) 100%);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    text-align: center;
    color: var(--gray-light);
    font-size: 1.1rem;
    margin-bottom: 3rem;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .feature-card {
    background: rgba(124, 58, 237, 0.08);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 1rem;
    padding: 2rem;
    transition: all 0.3s ease;
    min-width: 0;
  }

  .feature-card:hover {
    background: rgba(124, 58, 237, 0.14);
    border-color: rgba(124, 58, 237, 0.4);
    transform: translateY(-2px);
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--purple-bright), #9333ea);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    color: var(--white);
  }

  .feature-badge {
    display: inline-flex;
    align-items: center;
    margin-bottom: 0.85rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.45rem;
    border: 1px solid rgba(167, 139, 250, 0.35);
    color: var(--purple-light);
    background: rgba(124, 58, 237, 0.1);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .feature-badge.premium {
    border-color: rgba(232, 121, 249, 0.45);
    color: #f0abfc;
    background: rgba(232, 121, 249, 0.12);
  }

  .feature-badge.mixed {
    border-color: rgba(192, 132, 252, 0.45);
    color: var(--white-muted);
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.16), rgba(232, 121, 249, 0.12));
  }

  .feature-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    color: var(--gray-light);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .screenshots {
    padding: 6rem 0;
    background: var(--purple-dark);
  }

  .screenshots .container {
    max-width: 100%;
    padding: 0;
  }

  .screenshot-scroll {
    margin-top: 3rem;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 1rem;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    touch-action: pan-x;
  }

  .screenshot-scroll::-webkit-scrollbar {
    display: none;
  }

  .screenshot-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    min-width: 100%;
    justify-content: center;
    padding: 0 2rem;
  }

  .screenshot-item {
    flex-shrink: 0;
    width: 280px;
    scroll-snap-align: center;
  }

  .screenshot-item img {
    width: 100%;
    border-radius: 1.25rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s ease;
  }

  .screenshot-item img:hover {
    transform: scale(1.03);
  }

  .pricing {
    padding: 6rem 0;
    background: linear-gradient(180deg, var(--purple-dark) 0%, var(--purple-deep) 100%);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 700px;
    margin: 3rem auto 0;
  }

  .pricing-card {
    background: rgba(124, 58, 237, 0.08);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 1.25rem;
    padding: 2.5rem 2rem;
    text-align: center;
    position: relative;
    min-width: 0;
  }

  .pricing-card.popular {
    border-color: var(--purple-bright);
    background: rgba(124, 58, 237, 0.15);
    box-shadow: 0 0 40px rgba(124, 58, 237, 0.2);
  }

  .popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, var(--purple-bright), #9333ea);
    color: var(--white);
    padding: 0.3rem 1rem;
    border-radius: 2rem;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .pricing-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--gray-light);
    margin-bottom: 1rem;
  }

  .price {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    line-height: 1.15;
  }

  .price span {
    font-size: 1rem;
    font-weight: 400;
    color: var(--gray-light);
  }

  .pricing-card ul {
    list-style: none;
    text-align: left;
  }

  .pricing-card li {
    padding: 0.5rem 0;
    color: var(--white-muted);
    font-size: 0.95rem;
  }

  .pricing-card li::before {
    content: '\2713';
    color: var(--purple-bright);
    margin-right: 0.5rem;
    font-weight: 700;
  }

  .download {
    padding: 6rem 0;
    text-align: center;
    background: radial-gradient(ellipse at center, rgba(124, 58, 237, 0.15) 0%, transparent 70%);
  }

  .download-icon {
    width: 100px;
    height: 100px;
    border-radius: 1.5rem;
    margin: 0 auto 1.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .download h2 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .download p {
    color: var(--gray-light);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .store-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .store-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--white);
    color: #111;
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    transition: all 0.3s ease;
    min-width: 0;
  }

  .store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    color: #111;
  }

  .store-label {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .store-name {
    display: block;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .footer {
    background: var(--purple-deep);
    border-top: 1px solid rgba(124, 58, 237, 0.2);
