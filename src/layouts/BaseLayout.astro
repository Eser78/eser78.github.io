---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonicalPath?: string;
  alternates?: Array<{
    lang: string;
    path: string;
  }>;
  detectBrowserLocale?: boolean;
}

const {
  title,
  description,
  lang = 'en',
  canonicalPath,
  alternates = [],
  detectBrowserLocale = false,
} = Astro.props;
const origin = Astro.site ?? Astro.url.origin;
const canonicalUrl = canonicalPath ? new URL(canonicalPath, origin).toString() : undefined;
const browserLocaleRedirectScript = `(() => {
  try {
    const path = window.location.pathname.replace(/\\/$/, '') || '/';
    if (!['/', '/revera'].includes(path) || localStorage.getItem('preferredLocale')) return;
    const supported = new Set(['de', 'es', 'fr', 'it', 'pt']);
    const languages = navigator.languages && navigator.languages.length
      ? navigator.languages
      : [navigator.language];
    const match = languages
      .map((language) => String(language || '').toLowerCase().split('-')[0])
      .find((language) => supported.has(language));
    if (!match) return;
    const target = path === '/revera' ? '/' + match + '/revera' : '/' + match;
    window.location.replace(target + window.location.search + window.location.hash);
  } catch (_) {}
})();`;
const preferredLocaleScript = `document.addEventListener('click', (event) => {
  const link = event.target && event.target.closest
    ? event.target.closest('[data-preferred-locale]')
    : null;
  if (!link) return;
  try {
    localStorage.setItem('preferredLocale', link.getAttribute('data-preferred-locale'));
  } catch (_) {}
});`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {detectBrowserLocale && <script is:inline set:html={browserLocaleRedirectScript} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.path, origin).toString()} />
      ))
    }
    <link rel="icon" type="image/png" href="/revera/images/AppIcon1024.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script is:inline set:html={preferredLocaleScript} />
  </body>
</html>
