---
import BaseLayout from './BaseLayout.astro';
import {
  getLegalPath,
  localeConfig,
  type Locale,
} from '../lib/locales';

interface Props {
  title: string;
  description: string;
  heading: string;
  lastUpdated?: string;
  locale?: Locale;
  canonicalPath: string;
  alternates: Array<{
    lang: string;
    path: string;
  }>;
}

const { title, description, heading, lastUpdated, locale = 'en', canonicalPath, alternates } = Astro.props;
const localeData = localeConfig[locale];
const labels = localeData.labels;
---

<BaseLayout
  title={title}
  description={description}
  lang={locale}
  canonicalPath={canonicalPath}
  alternates={alternates}
>
  <header class="legal-header">
    <div class="container">
      <a href={localeData.reveraPath} class="back-link">&larr; {labels.backToRevera}</a>
    </div>
  </header>
  <main class="legal-main">
    <div class="container">
      <h1>{heading}</h1>
      {lastUpdated && <p class="last-updated">{labels.lastUpdated}: {lastUpdated}</p>}
      <div class="legal-content">
        <slot />
      </div>
    </div>
  </main>
  <footer class="legal-footer">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} ESOciate - Eser Kayali. {labels.rights}</p>
      <nav class="footer-links">
        <a href={localeData.reveraPath}>Revera</a>
        <a href={getLegalPath(locale, 'privacyPolicy')}>{labels.privacyPolicy}</a>
        <a href={getLegalPath(locale, 'termsOfUse')}>{labels.termsOfUse}</a>
        <a href={getLegalPath(locale, 'legalNotice')}>{labels.legalNotice}</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<style>
  .legal-header {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(124, 58, 237, 0.2);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  .back-link {
    font-size: 0.95rem;
    color: var(--purple-light);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .legal-main {
    padding: 3rem 0 4rem;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--white), var(--purple-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .last-updated {
    color: var(--gray-light);
    font-size: 0.9rem;
    margin-bottom: 2.5rem;
  }

  .legal-content {
    color: var(--white-muted);
    line-height: 1.8;
    overflow-wrap: break-word;
  }

  .legal-content :global(h2) {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--white);
    margin: 2.5rem 0 1rem;
  }

  .legal-content :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--white);
    margin: 1.5rem 0 0.75rem;
  }

  .legal-content :global(p) {
    margin-bottom: 1rem;
  }

  .legal-content :global(ul),
  .legal-content :global(ol) {
    margin: 0.75rem 0 1rem 1.5rem;
  }

  .legal-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .legal-content :global(a) {
    color: var(--purple-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-footer {
    border-top: 1px solid rgba(124, 58, 237, 0.2);
    padding: 2rem 0;
    text-align: center;
  }

  .legal-footer p {
    color: var(--gray-light);
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .legal-header {
      padding: 1rem 0;
    }

    .container {
      padding: 0 1rem;
    }

    h1 {
      font-size: 1.75rem;
      line-height: 1.2;
    }

    .legal-main {
      padding: 2rem 0 3rem;
    }

    .footer-links {
      gap: 0.75rem 1rem;
    }
  }

  @media (max-width: 380px) {
    h1 {
      font-size: 1.55rem;
    }

    .legal-content {
      font-size: 0.95rem;
    }

    .legal-content :global(h2) {
      font-size: 1.2rem;
    }
  }
</style>
